# ── Supabase (your app's own project — auth + storage) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # server-only, never exposed

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32-byte base64 key for encrypting integration tokens at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ── GitHub OAuth App (github.com/settings/developers → New OAuth App)
# Authorization callback URL: {APP_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OpenAI (optional — briefs fall back to deterministic prose) ─────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Resend (optional — daily brief email) ───────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Founder Brief <brief@yourdomain.com>"

# ── Cron (protect /api/cron/hourly; set the same value in Vercel) ───
CRON_SECRET= 