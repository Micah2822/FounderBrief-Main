# ── Supabase (your app's own project — auth + storage) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # server-only, never exposed

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32-byte base64 key for encrypting integration tokens at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ── GitHub App (github.com/settings/apps → New GitHub App) ──────────
# A GitHub *App*, not an OAuth App: only Apps offer read-only permissions on
# private repos, and they allow several callback URLs so one app covers both
# production and localhost. Read-only: contents, pull requests, issues,
# deployments, metadata. Callback: {APP_URL}/api/integrations/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The .pem GitHub gives you. Real newlines or literal \n both work.
GITHUB_APP_PRIVATE_KEY=

# ── Supabase OAuth app (the FOUNDER's Supabase, not the app's own) ───
# Supabase dashboard → Organization Settings → OAuth Apps.
# Redirect URL: {APP_URL}/api/integrations/supabase/callback
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# ── OpenAI (optional — briefs fall back to deterministic prose) ─────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Resend (optional — daily brief email) ───────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Founder Brief <brief@yourdomain.com>"

# ── Cron (protect /api/cron/hourly; set the same value in Vercel) ───
CRON_SECRET= 