# ── Supabase (your app's own project — auth + storage) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # server-only, never exposed

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32-byte base64 key for encrypting integration tokens at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ── GitHub App (github.com/settings/apps → New GitHub App) ──────────
# A GitHub *App*, not an OAuth App: only Apps offer read-only permissions on
# private repos, and they allow several callback URLs so one app covers both
# production and localhost. Read-only: contents, pull requests, issues,
# deployments, metadata. Callback: {APP_URL}/api/integrations/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The .pem GitHub gives you, on ONE line and quoted:
#   awk '{printf "%s\\n", $0}' key.pem | pbcopy
# Real newlines work only if the whole block is wrapped in double quotes —
# unquoted, dotenv keeps just the -----BEGIN line and signing fails later.
# Verify with: node scripts/check-github-app.mjs
GITHUB_APP_PRIVATE_KEY=

# ── Supabase OAuth app (the FOUNDER's Supabase, not the app's own) ───
# Supabase dashboard → Organization Settings → OAuth Apps.
# Redirect URL: {APP_URL}/api/integrations/supabase/callback
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# ── OpenAI (optional — briefs fall back to deterministic prose) ─────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Resend (optional — daily brief email) ───────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Founder Brief <brief@yourdomain.com>"

# ── Cron (protect /api/cron/hourly; set the same value in Vercel) ───
CRON_SECRET= 

# Operator alert when a cron run fails some users. Unset = alerts off.
# The same variable is both the switch and the recipient.
ALERT_EMAIL=


# ── Stripe (billing — YOUR Stripe account, not a user's) ─────────────
# Not to be confused with the Stripe *connector*, where a user pastes their own
# rk_ so their revenue appears in their brief. That key is theirs and lives
# encrypted in the database; these three are yours and live only here. The
# BILLING infix is what keeps the two from ever being reached for by mistake.
#
# Restricted, never a secret key. Write on exactly four resources — Customers,
# Checkout Sessions, Customer portal, Subscriptions — and None on everything
# else. Founder Brief never creates a charge or issues a refund, so the key
# should not be able to. See README section 5.
STRIPE_BILLING_SECRET_KEY=rk_test_...
# Signing secret for /api/billing/webhook. In development this comes from
# `stripe listen` and is DIFFERENT from the one the dashboard shows for a
# hosted endpoint — using the dashboard's value locally fails every signature.
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...
# The price, not the product: price_... from the pricing row, not prod_...
# Sandbox and live have separate products and therefore different price ids.
STRIPE_PRICE_FOUNDER=price_...

# ── Mixpanel (product analytics) ─────────────────────────────────────
# Public by design: this token only authorises *writing* events, and it is
# compiled into the browser bundle where anyone can read it. It is not a
# secret and needs no rotation policy. Mixpanel → Settings → Project Token.
# Unset = analytics off everywhere, silently — which is the right default for
# local development and for anyone running their own copy.
NEXT_PUBLIC_MIXPANEL_TOKEN=
